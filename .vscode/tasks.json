{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "dotnet",
      "task": "build",
      "group": "build",
      "label": "dotnet: build"
    },
    {
      "type": "docker-build",
      "label": "docker-build: debug",
      "dependsOn": ["dotnet: build"],
      "dockerBuild": {
        "tag": "course.cloudnativedev.api:dev",
        "target": "base",
        "dockerfile": "${workspaceFolder}/Course.CloudNativeDev.Api/Dockerfile",
        "context": "${workspaceFolder}"
      },
      "netCore": {
        "appProject": "${workspaceFolder}/Course.CloudNativeDev.Api/Course.CloudNativeDev.Api.csproj"
      }
    },
    {
      "type": "docker-run",
      "label": "docker-run: debug",
      "dependsOn": ["docker-build: debug"],
      "dockerRun": {
        "ports": [
          { "containerPort": 8080, "hostPort": 8080 },
          { "containerPort": 8081, "hostPort": 8081 }
        ],
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_HTTP_PORTS": "8080"
        }
      },
      "netCore": {
        "appProject": "${workspaceFolder}/Course.CloudNativeDev.Api/Course.CloudNativeDev.Api.csproj",
        "enableDebugging": true
      }
    }
  ]
}
