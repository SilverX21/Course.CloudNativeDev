{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker .NET Launch",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-run: debug",
      "netCore": {
        "appProject": "${workspaceFolder}/Course.CloudNativeDev.Api/Course.CloudNativeDev.Api.csproj"
      },
      "dockerServerReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:8080/scalar"
      }
    }
  ]
}
